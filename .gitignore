/public/uploads/
/upload/
uploads/

# Misc
.DS_Store
*.pem
Thumbs.db

# SKAT certificates & keystores (CONFIDENTIAL — never commit)
# VOCES3 .p12/.pfx keystores, CA bundles, and split PEM cert/key files
certs/
*.p12
*.pfx
*.keystore
*.jks
*.crt
*.cer
*.key
*.ca-bundle
# …but keep the guide README so developers know what to place here
!certs/
!certs/skat/
!certs/skat/README.md

